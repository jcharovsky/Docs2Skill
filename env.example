# LLM Configuration for SKILL.md Generation
# Copy this file to .env and fill in your values

# LLM Provider
# Supported: 'anthropic', 'openai', 'openrouter', 'gemini', 'grok', 'ollama'
LLM_PROVIDER=anthropic

# Your API Key (not required for Ollama)
LLM_API_KEY=your_api_key_here

# Model ID to use
# Claude Sonnet 5 is the balanced default for skill generation.
# See current options below for each provider.
LLM_MODEL=claude-sonnet-5

# API Endpoint (optional - defaults are provided for each provider)
# Only specify if you need to override the default
# LLM_ENDPOINT=

# ============================================================================
# SUPPORTED MODELS BY PROVIDER
# ============================================================================

# ANTHROPIC
# Models: claude-fable-5, claude-opus-5, claude-sonnet-5,
#         claude-haiku-4-5-20251001
# Catalog: https://platform.claude.com/docs/en/models/overview
# Default endpoint: https://api.anthropic.com/v1/messages

# OPENAI
# Models: gpt-5.6-sol, gpt-5.6-terra, gpt-5.6-luna, gpt-5.5,
#         gpt-5.4, gpt-5.2, gpt-5-mini, gpt-4.1
# Catalog: https://developers.openai.com/api/docs/models
# Default endpoint: https://api.openai.com/v1/chat/completions
# Note: gpt-5.6-sol favors quality, gpt-5.6-terra balances quality and cost,
#       and gpt-5.6-luna favors speed and volume.

# GOOGLE GEMINI
# Models: gemini-3.6-flash, gemini-3.5-flash, gemini-3.5-flash-lite,
#         gemini-3.1-flash-lite, gemini-3.1-pro-preview, gemini-2.5-pro
# Catalog: https://ai.google.dev/gemini-api/docs/models
# Default endpoint: https://generativelanguage.googleapis.com/v1beta/models/
# Note: Requires API key from https://aistudio.google.com/app/apikey

# GROK (xAI)
# Models: grok-4.6
# Catalog: https://docs.x.ai/developers/models
# Default endpoint: https://api.x.ai/v1/chat/completions
# Note: Requires API key from https://console.x.ai

# OPENROUTER
# Models: openai/gpt-5.6-sol, anthropic/claude-sonnet-5,
#         google/gemini-3.6-flash, x-ai/grok-4.6
# Catalog: https://openrouter.ai/models
# Model IDs change frequently. Query https://openrouter.ai/api/v1/models for
# the complete current list.
# Default endpoint: https://openrouter.ai/api/v1/chat/completions

# OLLAMA (Local)
# Models: qwen3.8, qwen3.6, gemma4:12b, gemma4:26b, deepseek-r1:32b
# Catalog: https://ollama.com/search
# Default endpoint: http://localhost:11434/v1/chat/completions
# Note: No API key required. Requires Ollama running locally.
# Install: https://ollama.com/download
